{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p .vercel-redirect && touch .vercel-redirect/index.html",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "outputDirectory": ".vercel-redirect",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://hirobius-hds-components.vercel.app/docs",
      "permanent": true
    }
  ]
}
