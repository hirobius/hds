{
  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#ffffff" },
      "black": { "$value": "#000000" }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 10, "unit": "px" } },
      "lg": { "$value": { "value": 15, "unit": "px" } }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "surface": { "$value": "{primitive.color.white}" },
      "ink": { "$value": "{primitive.color.black}" }
    }
  },
  "component": {
    "button": {
      "color": {
        "$type": "color",
        "bg": { "$value": "{semantic.color.surface}" }
      }
    }
  }
}
