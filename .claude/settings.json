{
  "permissions": {
    "deny": [
      "mcp__Gmail",
      "mcp__Google_Calendar",
      "mcp__Google_Drive",
      "mcp__Wix",
      "mcp__Excalidraw",
      "mcp__Claude_Docs",
      "mcp__Supabase"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:algorithmic-art": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "keybindings-help": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Bootstrapping fresh clone (install + manifest + audit)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-pr-body.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking PR body shape..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *\"gh pr create\"*) printf %s \"$input\" | node \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-pr-body.mjs\";; esac",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking PR body shape..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec eslint --fix --quiet $CLAUDE_FILE_PATHS 2>/dev/null || true",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Auto-formatting touched files..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *hirobius.tokens.json*) cd \"$(git rev-parse --show-toplevel)\" && pnpm tokens:verify 2>&1;; esac; } || true",
            "shell": "bash",
            "timeout": 45,
            "statusMessage": "Verifying token pipeline..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *theme.css*) cd \"$(git rev-parse --show-toplevel)\" && pnpm check:css 2>&1;; esac; } || true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking CSS integrity..."
          }
        ]
      }
    ]
  }
}
