{
  "impact": "look",
  "plain": "Token bundles are smaller; nothing renders differently, and four orphaned utilities are gone.",
  "steps": [
    {
      "id": "behavior/orphaned-safelist",
      "kind": "behavior",
      "impact": "none",
      "plain": "Drops four Tailwind utilities no HDS component uses (a removed badge token, a deprecated weight, drop-shadow); add them in your own CSS if you used them.",
      "detect": {
        "regex": ["paddingShift|weight-medium|drop-shadow"]
      },
      "facts": [
        "utility-removed:[font-weight:var(--primitive-typography-weight-medium)]",
        "utility-removed:pb-[calc(var(--component-badge-paddingY)+var(--component-badge-paddingShift))]",
        "utility-removed:pt-[calc(var(--component-badge-paddingY)-var(--component-badge-paddingShift))]",
        "utility-removed:drop-shadow"
      ]
    },
    {
      "id": "value-changed/--semantic-accent-delight-base",
      "kind": "value-changed",
      "impact": "look",
      "plain": "The dark block no longer repeats this variable; it resolves to the same value as before, so nothing looks different.",
