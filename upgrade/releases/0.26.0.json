    {
      "id": "0.26.0/look/Alert-Callout-Badge-shape",
      "kind": "look",
      "impact": "look",
      "plain": "Alert is padded like Callout (24px instead of 8px), and Alert, Callout, Badge and CodeBlock use the action radius (8px, following a tenant role.radius) instead of a fixed 4px or 8px; nothing to change unless you styled around the old size.",
      "detect": {
        "regex": [
          "<Alert\\b",
          "<Callout\\b",
          "<Badge\\b"
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/look/Card-parts-inset",
      "kind": "look",
      "impact": "look",
      "plain": "Card.Header, Card.Body, Card.Footer, Card.Progress and Card.Metric no longer add their own 24px inside a padded Card, so their content moves out to the Card's single 24px inset, while a Card with padding none keeps the parts' own padding.",
      "detect": {
        "regex": [
          "<Card\\.(Header|Body|Footer|Progress|Metric)\\b",
          "<Card(Header|Body|Footer|Progress|Metric)\\b"
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/look/FormField-error-border",
      "kind": "look",
      "impact": "look",
      "plain": "Input, Textarea, Select and Combobox now draw the red error border whenever aria-invalid is true, and Input and Textarea labels sit 8px above the control instead of 6px; nothing to change unless you styled around the old gap.",
      "detect": {
        "regex": [
          "<FormField\\b[^>]*\\berror="
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/look/MetadataList-divided",
      "kind": "look",
      "impact": "look",
      "plain": "MetadataList variant divided no longer draws a padded, rounded, bordered box and renders its value in body type; wrap it in a Card or Surface if you want the box.",
      "detect": {
        "regex": [
          "<MetadataList\\b[^>]*variant=[\"']divided"
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/look/Page-gutter",
      "kind": "look",
      "impact": "look",
      "plain": "Page now pads its content with the region gutter (24px, 16px below 640px), so content that relied on running edge to edge is inset; pass style paddingLeft and paddingRight of 0 to keep the old fit.",
      "detect": {
        "regex": [
          "<Page\\b"
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/look/a11y-contracts-navigation-actions",
      "kind": "look",
      "impact": "look",
      "plain": "The Disclosure trigger is at least 24px tall, copyable CodeBlock and InlineCode gain a hidden copy-status element, and a clickable non-expandable AssetImg becomes a focusable button; nothing to change unless you snapshot their markup or height.",
      "source": "CHANGELOG.md:29"
    },
    {
      "id": "0.26.0/behavior/Button-label",
      "kind": "behavior",
      "impact": "behavior",
      "plain": "Button label now sets the accessible name whenever it is given, even with children, so a Button that passes both is announced by the label and the label should still describe the visible text.",
      "detect": {
        "regex": [
          "<Button\\b[^>]*\\slabel="
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/behavior/CodeBlock-landmark",
      "kind": "behavior",
      "impact": "behavior",
      "plain": "A CodeBlock is no longer a region named Code sample with its own tab stop; it becomes a keyboard-scrollable group named by its filename or language only when its code overflows, so update any test or selector that looked for that region.",
      "detect": {
        "regex": [
          "Code sample"
        ]
      },
      "source": "CHANGELOG.md:33"
    },
    {
      "id": "0.26.0/manual/typed-icon-color-table-width",
      "kind": "manual",
      "impact": "breaking",
      "plain": "Icon color and Table column width are now typed to tokens: pass currentColor or a var(--semantic-…) token as the colour, and an fr value, minmax(), max-content or a var(--…) token as the width; a hex, rgb(), px or rem value is a type error.",
      "source": "CHANGELOG.md:24"
    }
