{
  "impact": "look",
  "plain": "Setting --hds-font-family or --hds-font-family-mono (or HdsThemeProvider's fontFamily props) now changes the rendered font at that scope; with no override nothing changes.",
  "steps": [
    {
      "id": "value-changed/--primitive-typography-family-display",
      "kind": "value-changed",
      "impact": "look",
      "plain": "This variable now follows the font dial (--hds-font-family) at any scope; if you overrode it directly, override the dial instead.",
      "detect": {
        "cssVars": ["--primitive-typography-family-display"],
        "cssVarWrites": ["--primitive-typography-family-display"]
      },
      "facts": [
        "css-var-changed:--primitive-typography-family-display::where([data-hds],[data-hds] *)"
