{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "packageRules": [
    {
      "description": "One PR a week for every non-major dev dependency.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "Peer ranges are part of the public API: a change ships to every consumer, so a human reviews each one.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "GitHub Actions pins, grouped.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
