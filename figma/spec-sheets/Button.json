  "usage": {
    "when": "Run an action, such as submit, save or open a dialog. For an icon-only control pass iconOnly, iconLeft and label; for an on/off toggle pass pressed. For a low-priority action beside a primary one use variant=\"tertiary\" tone=\"quiet\"; for a back link whose icon lines up with the heading add flush; for an action that reads as a text link in a row use variant=\"link\".",
