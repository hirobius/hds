#!/usr/bin/env sh
set -e

# Quiet by default: scripts/hook-run.mjs runs each stage below (the echo line
# names it, the lines under it are its commands), prints one summary line when
# green and only the failing stage + a log path when red. HOOK_VERBOSE=1 runs
# this file as-is with full output.
[ -n "$HOOK_RUN_RAW" ] || exec node scripts/hook-run.mjs "$(basename "$0")"

# ── Lean pre-commit gate set (ADR-018 §5 / #52) ──────────────────────────────
# Fast, deterministic, environment-agnostic: no network fetches, no browser, no
# binary downloads. This ends the --no-verify era — every gate here runs in any
# environment (local, CI, remote agent sessions).
#
# The full 56-gate guardrail registry (docs/guardrails/registry.json) and its
# scripts/check-*.mjs / scripts/audit-*.mjs are ARCHIVED IN PLACE, not deleted:
# recoverable, still runnable on demand (`node scripts/run-gates.mjs --channel
# ci-pr` in CI, or any gate directly), just no longer wired into the hooks. The
# Swiss-canon rules remain as documentation.

echo "Secrets scan (gitleaks; skips gracefully if absent)…"
pnpm check:secrets

echo "Prettier (staged files)…"
node scripts/run-lint-staged.mjs

echo "Typecheck…"
pnpm typecheck

echo "ESLint (zero warnings)…"
pnpm lint --max-warnings=0

echo "Token pipeline validity (verify-tokens + check-contrast)…"
node scripts/verify-tokens.mjs
node scripts/check-contrast.mjs

# Joins source, manifest, docs page and Figma into one table and fails when they
# drift apart. Qualifies for this lean set: 0.6s, no network, no browser, no
# build -- docs pages are routed from the core set, so it runs anywhere.
# (Every core component and pattern having a docs page with a live demo is
# tests/docs-site/component-pages.test.ts, run by pnpm test.)
echo "Record join (source ↔ manifest ↔ docs page ↔ Figma)…"
node scripts/check-sync-map.mjs
node scripts/check-sync-map.mjs --check

# A core component with no usage.when leaves an agent guessing which one to
# reach for. Reads the manifest only: no network, no browser, no build.
echo "Contract coverage (every core component says when to use it)…"
node scripts/check-contract-coverage.mjs --enforce

# hds#520: every interactive component states its accessibility contract as
# @a11y tags, and each rule the component keeps points at a test. Severity
# error: --enforce fails the commit on any gap (the family backfills reached
# zero). Reads the manifest and greps the test files: no build, no browser, no
# network.
echo "A11y contracts (interactive components state and test their a11y rules)…"
node scripts/check-a11y-contracts.mjs --enforce

# A bare top-level React.forwardRef / cva / createContext / withHdsPortal call
# is a side effect every bundler keeps, so one in a module that reaches the
# chunk shared with Button re-breaks the Button-only budget (hds#363). Source
# only: parses src/ with the TypeScript API, no build, no network.
echo "Pure annotations (top-level factory calls, compound Object.assign and X.Part writes)…"
node scripts/check-pure-annotations.mjs

# hds#206: spacing is the t-shirt scale (xs/sm/md/lg/xl). A raw integer on a Box
# sx spacing prop reads as px but is a count of 4px units (p: 4 is 16px). Source
# only: parses the src/ files that use sx with the TypeScript API, no build, no
# network.
echo "Spacing vocabulary (no raw integers on sx spacing props)…"
node scripts/check-spacing-vocabulary.mjs

# hds#404: the layout-gap names ('tight'..'spacious') map to the t-shirt scale in
# one place, box-sx.ts. A second copy drifts from Stack's names unseen. Source
# only: parses the src/ files that pair one of the names with a scale step using
# the TypeScript API, no build, no network.
echo "Layout-gap vocabulary (one name map, in box-sx.ts)…"
node scripts/check-layout-gap-vocabulary.mjs

# hds#486: the type ramp is 5 roles plus mono (display, title, body, ui, caption,
# mono). A raw size, weight or line height in src/, or a deprecated composite
# (h1..h3, eyebrow, technical, ...), reads as design but is off the ramp. Source
# only: reads src/ and hirobius.tokens.json, no build, no network.
echo "Type ramp (src/ uses the six roles only)…"
node scripts/check-type-ramp.mjs

# hds#568 (ops#568): ralph/{lib,next,run,loop,status}.sh and prompt.md are
# vendored byte-identical from hirobius/ralph/kit. A local edit is caught here,
# not only by ralph-gate in CI. --staged: no-op unless a kit file is staged.
echo "Ralph kit drift (vendored kit files match ralph/kit.lock.json)…"
node scripts/check-ralph-kit-drift.mjs --staged

# ops#610 (ops#600): .claude/lessons/ holds the fleet lessons ledger and the recall
# hook, vendored byte-identical from hirobius/ops (`pnpm lessons:vendor` there). A
# local edit is caught here, not at the next session. Hashes only: no network, no
# build. Fix: re-run lessons:vendor from the ops checkout.
echo "Lessons copy (vendored .claude/lessons matches its lock)…"
node .claude/lessons/check-drift.mjs
