#!/usr/bin/env sh
# Post-commit: non-blocking background work.
#
# Refreshes ready-queue.json so the next agent pick is instant. Detached and
# nohup'd so `git commit` returns immediately.
#
# The firing-log re-run that used to live here was removed with the rest of the
# registry firing telemetry (ADR-027). It re-ran the pre-commit channel on every
# commit to make --no-verify bypasses auditable, but that channel holds exactly
# one gate, so the log only ever recorded check-contrast — and nothing acted on
# it. Detecting a bypass is worth doing; doing it by re-running one gate in the
# background and writing a file no one reads was not.

ROOT="$(git rev-parse --show-toplevel)"

nohup node "$ROOT/scripts/orchestration-watcher.mjs" --once --quiet \
  >/dev/null 2>&1 </dev/null &

exit 0
