{
  "name": "@hirobius/eslint-plugin-hds",
  "version": "0.2.0",
  "description": "Consumer ESLint plugin for the Hirobius Design System — flags raw hex/px values in style, className and Box sx, and raw HTML form controls.",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "index.d.mts",
    "rules",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "hirobius",
    "design-system"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "scripts": {
    "test": "pnpm --dir ../.. exec vitest run scripts/eslint-plugin-hds"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.mts"
}
