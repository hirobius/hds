          "size.md.height": ".hds-button--md | height",
          "size.md.paddingY": ".hds-button--md | padding | 0",
          "size.md.paddingX": ".hds-button--md | padding | 1",
          "size.md.iconSize": ".hds-button svg | width",
          "size.md.itemSpacing": ".hds-button | gap",
          "size.lg.height": ".hds-button--lg | height",
          "size.lg.paddingX": ".hds-button--lg | padding | 1",
          "size.lg.iconSize": ".hds-button--lg svg | width",
          "size.lg.itemSpacing": ".hds-button--lg | gap"
        }
      },
      "rules": [
        {
          "match": "bg",
          "ctx": {
            "variant": "primary"
          }
        },
        {
          "match": "bgHover",
          "ctx": {
            "variant": "primary"
          }
        },
        {
          "match": "text",
          "ctx": {
            "variant": "primary"
          }
        },
        {
          "match": "focus.*",
          "prop": "radius"
        },
        {
          "match": "radius"
        },
        {
          "match": "paddingX",
          "ctx": {
            "size": "md"
          }
        },
        {
          "match": "paddingY",
          "ctx": {
            "size": "md"
          }
        },
        {
          "match": "size.*.paddingX",
          "ctx": {
            "size": "$1"
          }
        },
        {
          "match": "size.*.paddingY",
          "ctx": {
            "size": "$1"
          }
        },
        {
          "match": "size.*.fontSize",
          "ctx": {
            "size": "$1"
          }
        },
        {
          "match": "size.*.iconSize",
          "ctx": {
            "size": "$1"
          },
          "state": "[&_svg]"
        },
        {
          "match": "size.*.height",
          "ctx": {
            "size": "$1"
          }
        },
        {
          "match": "size.*.itemSpacing",
          "ctx": {
            "size": "$1"
          }
        },
        {
          "match": "primary.textDisabled",
          "ctx": {
            "variant": "primary"
          },
          "prop": "color",
          "state": ["disabled", ""]
        },
        {
          "match": "primary.bgDisabled",
          "ctx": {
            "variant": "primary"
          },
          "prop": "fill",
          "state": ["disabled", ""]
        },
        {
          "match": "secondary.*.*",
          "ctx": {
            "variant": "secondary"
          }
        },
        {
          "match": "secondary.text",
          "ctx": {
            "variant": "secondary"
          }
        },
        {
          "match": "edge.primary",
          "declared": {
            "token": "component.button.edge.primary",
            "evidence": "primary: 'var(--hds-edge-primary)'",
            "note": "Button paints the primary edge through --hds-edge-primary, which tokens.generated.css sets to var(--component-button-edge-primary); accents and tenants override --hds-edge-primary with their own computed edge (scripts/lib/raised-edge.mjs)."
          }
        },
        {
          "match": "depth.edge",
          "declared": {
            "token": "component.button.depth.edge",
            "evidence": "hard: 'hds-btn-hard'",
            "note": "Button takes its depth from the .hds-btn-hard class; theme.css reads var(--component-button-depth-edge) there for the edge height and the ::after hit band (hds#1387)."
          }
        },
        {
          "match": "depth.hoverOffset",
          "declared": {
            "token": "component.button.depth.hoverOffset",
            "evidence": "hard: 'hds-btn-hard'",
            "note": "Button takes its depth from the .hds-btn-hard class; theme.css reads var(--component-button-depth-hoverOffset) there for the face travel on hover (the edge shrinks by it) (hds#1387)."
          }
        },
        {
          "match": "depth.pressedOffset",
          "declared": {
            "token": "component.button.depth.pressedOffset",
            "evidence": "hard: 'hds-btn-hard'",
            "note": "Button takes its depth from the .hds-btn-hard class; theme.css reads var(--component-button-depth-pressedOffset) there for the face travel on press (the edge shrinks by it) (hds#1387)."
          }
        }
      ]
    },
