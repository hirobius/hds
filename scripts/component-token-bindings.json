          "fontWeight": ".hds-button | font-weight",
          "primary.bgDisabled": ".hds-button[aria-disabled='true'] | background-color",
          "primary.textDisabled": ".hds-button[aria-disabled='true'] | color",
          "secondary.bg.rest": ".hds-button--secondary | background-color",
          "secondary.bg.hover": ".hds-button--secondary:hover | background-color",
          "secondary.bg.pressed": ".hds-button--secondary:active | background-color",
          "secondary.text": ".hds-button--secondary | color",
          "tertiary.bg.hover": ".hds-button--tertiary:hover | background-color",
          "tertiary.bg.pressed": ".hds-button--tertiary:active | background-color",
          "size.sm.height": ".hds-button--sm | height",
          "size.sm.paddingX": ".hds-button--sm | padding | 1",
