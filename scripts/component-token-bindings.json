{
  "$comment": "Source of truth for check-component-token-binding.mjs: which component source consumes each component.* token group. Leaves are inferred from their names (height, paddingX, iconSize, bg, bgHover, ...; table PROP_BY_NAME in scripts/lib/component-token-binding.mjs); rules[] override the cva context, property or state. A rule's match is a dotted leaf path where * captures one segment as $1. state lists the Tailwind variant prefixes to look through, most specific first ('' is the resting state). Allowlist a deliberate literal with an inline `binding-ok: <group>.<leaf> <reason>` comment in the source.",
  "scan": ["src/app/components"],
  "groups": {
    "button": {
      "source": "src/app/components/button.tsx",
      "cva": "buttonVariants",
      "rules": [
        { "match": "bg", "ctx": { "variant": "primary" } },
        { "match": "bgHover", "ctx": { "variant": "primary" } },
        { "match": "text", "ctx": { "variant": "primary" } },
        { "match": "focus.*", "prop": "radius" },
        { "match": "radius" },
        { "match": "paddingX", "ctx": { "size": "md" } },
        { "match": "paddingY", "ctx": { "size": "md" } },
        { "match": "size.*.paddingX", "ctx": { "size": "$1" } },
        { "match": "size.*.paddingY", "ctx": { "size": "$1" } },
        { "match": "size.*.fontSize", "ctx": { "size": "$1" } },
        { "match": "size.*.iconSize", "ctx": { "size": "$1" }, "state": "[&_svg]" },
        { "match": "size.*.height", "ctx": { "size": "$1" } },
        { "match": "size.*.itemSpacing", "ctx": { "size": "$1" } },
        {
          "match": "primary.textDisabled",
          "ctx": { "variant": "primary" },
          "prop": "color",
          "state": ["disabled", ""]
        },
        {
          "match": "primary.bgDisabled",
          "ctx": { "variant": "primary" },
          "prop": "fill",
          "state": ["disabled", ""]
        },
        { "match": "secondary.*.*", "ctx": { "variant": "secondary" } },
        { "match": "secondary.text", "ctx": { "variant": "secondary" } },
        {
          "match": "edge.primary",
          "declared": {
            "token": "component.button.edge.primary",
            "evidence": "primary: 'var(--hds-edge-primary)'",
            "note": "Button paints the primary edge through --hds-edge-primary, which tokens.generated.css sets to var(--component-button-edge-primary); accents and tenants override --hds-edge-primary with their own computed edge (scripts/lib/raised-edge.mjs)."
          }
        }
      ]
    },
    "tag": {
      "source": "src/app/components/tag.tsx",
      "cva": "tagPillVariants",
      "css": {
        "file": "src/styles/static.css",
        "leaves": {
          "radius": ".hds-tag__pill | border-radius",
          "fontSize": ".hds-tag__pill | font-size",
          "fontWeight": ".hds-tag__pill | font-weight",
          "minHeight": ".hds-tag__pill | min-height",
          "minWidth": ".hds-tag__pill | min-width",
          "paddingY": ".hds-tag__pill | padding | 0",
          "paddingX": ".hds-tag__pill | padding | 1",
          "border": ".hds-tag__pill | border-color",
          "background": ".hds-tag__pill | background-color",
          "text": ".hds-tag__pill | color",
          "activeBorder": ".hds-tag--active .hds-tag__pill | border-color",
          "activeBackground": ".hds-tag--active .hds-tag__pill | background-color",
          "activeText": ".hds-tag--active .hds-tag__pill | color",
          "activeHover": ".hds-tag--active:hover .hds-tag__pill | background-color"
        }
      },
      "rules": [
        { "match": "focus.*", "prop": "radius" },
        { "match": "background", "ctx": { "selected": "false" } },
        { "match": "text", "ctx": { "selected": "false" } },
        { "match": "border", "ctx": { "selected": "false" } },
        { "match": "activeText", "ctx": { "selected": "true" } },
        { "match": "activeBackground", "ctx": { "selected": "true" } },
        { "match": "activeBorder", "ctx": { "selected": "true" } },
        {
          "match": "activeHover",
          "ctx": { "selected": "true" },
          "prop": "fill",
          "state": "group-hover"
        }
      ]
    },
    "badge": {
      "source": "src/app/components/badge.tsx",
      "cva": "badgeVariants",
      "css": {
        "file": "src/styles/static.css",
        "leaves": {
          "fontSize": ".hds-badge | font-size",
          "fontWeight": ".hds-badge | font-weight",
          "height": ".hds-badge | height",
          "minWidth": ".hds-badge | min-width",
          "paddingY": ".hds-badge | padding | 0",
          "paddingX": ".hds-badge | padding | 1",
          "radius": ".hds-badge | border-radius",
          "neutral.bg": ".hds-badge--neutral | background-color",
          "neutral.text": ".hds-badge--neutral | color",
          "info.bg": ".hds-badge--info | background-color",
          "info.text": ".hds-badge--info | color",
          "success.bg": ".hds-badge--success | background-color",
          "success.text": ".hds-badge--success | color",
          "danger.bg": ".hds-badge--danger | background-color",
          "danger.text": ".hds-badge--danger | color",
          "warning.bg": ".hds-badge--warning | background-color",
          "warning.text": ".hds-badge--warning | color",
          "inProgress.bg": ".hds-badge--in-progress | background-color",
          "inProgress.text": ".hds-badge--in-progress | color"
        }
      },
      "rules": [
        { "match": "*.bg", "ctx": { "tone": "$1" } },
        { "match": "*.text", "ctx": { "tone": "$1" } }
      ]
    },
    "input": {
      "source": "src/app/components/input.tsx",
      "cva": "inputVariants",
      "rules": [
        { "match": "focus.*", "prop": "radius" },
        { "match": "borderError", "ctx": { "invalid": "true" } },
        { "match": "border", "ctx": { "invalid": "false" } },
        {
          "match": "paddingX",
          "ctx": { "size": "md" },
          "classesFrom": {
            "const": "ADORNMENT_BY_SIZE",
            "trail": ["md"],
            "keys": ["restPadL", "restPadR"]
          }
        },
        { "match": "paddingY", "ctx": { "size": "md" } }
      ]
    },
    "inlineCode": {
      "source": "src/app/components/inline-code.tsx",
      "cva": "inlineCodeVariants"
    },
    "list": {
      "source": "src/app/components/list.tsx",
      "cva": "listRowsVariants"
    },
    "pagination": {
      "source": "src/app/components/pagination.tsx",
      "cva": "paginationListVariants"
    },
    "card": {
      "source": "src/app/components/card.tsx",
      "cva": "cardVariants",
      "css": {
        "file": "src/styles/static.css",
        "leaves": {
          "bg": ".hds-card | background-color",
          "radius": ".hds-card | border-radius",
          "padding": ".hds-card | padding",
          "gap": ".hds-card | gap",
          "border": ".hds-card--bordered | border-color"
        }
      },
      "rules": [
        { "match": "focus.*", "prop": "radius" },
        {
          "match": "border",
          "ctx": { "variant": "default", "tone": "neutral", "bordered": "true" }
        },
        {
          "match": "padding",
          "declared": {
            "token": "semantic.space.surface.padding",
            "evidence": "padding = 'component'",
            "note": "Card pads through resolvePaddingValue(); its default padding='component' is var(--semantic-space-surface-padding)."
          }
        },
        {
          "match": "gap",
          "declared": {
            "token": "semantic.space.scale.sm",
            "evidence": "gap = 'tight'",
            "note": "Card gaps through resolveSpacingValue(); its default gap='tight' is LAYOUT_GAP_NAMES.tight = SPACE_SCALE.sm."
          }
        }
      ]
    },
    "inlineLink": {
      "$comment": "size.*.iconSize are the Figma-side px of the icon (Figma variables have no em). Code draws iconSize (0.75em) at every size, so those three read UNUSED by design.",
      "source": "src/app/components/inline-link.tsx",
      "rules": [
        {
          "match": "size.sm.fontSize",
          "declared": {
            "token": "primitive.typography.size.base",
            "evidence": "sm: 'ui'",
            "note": "InlineLink size=sm sets the ui role through the hds-type-ui class (SIZE_ROLE), whose font-size is this step."
          }
        },
        {
          "match": "size.md.fontSize",
          "declared": {
            "token": "primitive.typography.size.lg",
            "evidence": "md: 'body'",
            "note": "InlineLink size=md sets the body role through the hds-type-body class (SIZE_ROLE), whose font-size is this step."
          }
        },
        {
          "match": "size.lg.fontSize",
          "declared": {
            "token": "primitive.typography.size.title",
            "evidence": "lg: 'title'",
            "note": "InlineLink size=lg sets the title role through the hds-type-title class (SIZE_ROLE), whose font-size is this step."
          }
        }
      ]
    },
    "disclosure": {
      "source": "src/app/components/disclosure.tsx",
      "cva": "disclosureTriggerVariants",
      "rules": [{ "match": "paddingY", "ctx": { "variant": "nav" } }]
    },
    "nav": {
      "orphan": "TopNav, NavItem and SideNav were removed in 0.20.0 (hds#394) and their tokens after 0.32.0 (hds#431). component.nav.paddingY is deprecated (hds#1147): Disclosure reads component.disclosure.paddingY now."
    }
  }
}
