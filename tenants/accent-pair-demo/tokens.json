{
  "$schema": "../../hirobius.tenant-tokens.schema.json",
  "$description": "Accent pair demo, the primary half: mauve (a dusty plum) as the primary accent, built like the base accent (a dark fill in light mode, a light fill in dark mode) so the neutral onAccent text stays correct in both. Aliases {primitive.color.mauve.*}, which already exist in hirobius.tokens.json (R5, R8). The supporting accent is NOT a token and is not in this file: it is the CSS-variable overlay in support-overlay.css beside it (#628 decision 4). Demo exemplar only, no deployment, no legal entity.",
  "role": {
    "primary": {
      "$type": "color",
      "$value": "{semantic.color.surface.accent}",
      "$description": "Accent pair demo: re-anchored to the overridden surface.accent. --role-primary is declared on :root, so without this line a [data-brand] set below <html> leaves Button (bg-primary) on the default accent in light mode."
    },
    "ring": {
      "$type": "color",
      "$value": "{semantic.color.border.accent}",
      "$description": "Accent pair demo: re-anchored to the overridden border.accent, for the focus ring (same reason as role.primary)."
    },
    "accent": {
      "$type": "color",
      "$value": "{semantic.color.surface.accentSubtle}",
      "$description": "Accent pair demo: re-anchored to the overridden accentSubtle (hover fills; same reason as role.primary)."
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{semantic.color.content.accent}",
      "$description": "Accent pair demo: re-anchored to the overridden content.accent (same reason as role.primary)."
    }
  },
  "component": {
    "$type": "color",
    "$description": "Accent pair demo: every component alias of an overridden accent token, re-declared with the same alias as base. They are declared on :root, so a [data-brand] below <html> (the explorations harness puts it on the template's [data-theme] wrapper) would otherwise leave Button's primary hover, the secondary Button's hover, an active Tag and the active nav item on the default graphite in light mode.",
    "button": {
      "bg": { "$value": "{semantic.color.surface.accent}" },
      "bgHover": { "$value": "{semantic.accent.hover}" },
      "bgPressed": { "$value": "{semantic.accent.pressed}" },
      "secondary": {
        "bg": { "hover": { "$value": "{semantic.color.surface.accentSubtle}" } },
        "border": {
          "hover": { "$value": "{semantic.color.border.accent}" },
          "pressed": { "$value": "{semantic.color.border.accent}" }
        }
      }
    },
    "tag": {
      "activeBackground": { "$value": "{semantic.accent.rest}" },
      "activeBorder": { "$value": "{semantic.accent.rest}" },
      "activeHover": { "$value": "{semantic.accent.hover}" }
    },
    "nav": {
      "bgActive": { "$value": "{semantic.accent.subtle}" },
      "borderActive": { "$value": "{semantic.color.surface.accent}" }
    }
  },
  "semantic": {
    "accent": {
      "$type": "color",
      "rest": {
        "$value": "{primitive.color.mauve.600}",
        "$description": "Mauve primary accent: mauve.600 in light (white-ish text 8.4:1), mauve.300 in dark (graphite.900 text 6.6:1).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.600}",
              "Dark": "{primitive.color.mauve.300}"
            }
          }
        }
      },
      "hover": {
        "$value": "{primitive.color.mauve.700}",
        "$description": "Accent hover.",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.700}",
              "Dark": "{primitive.color.mauve.200}"
            }
          }
        }
      },
      "pressed": {
        "$value": "{primitive.color.mauve.800}",
        "$description": "Accent pressed.",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.800}",
              "Dark": "{primitive.color.mauve.100}"
            }
          }
        }
      },
      "subtle": {
        "$value": "{primitive.color.mauve.50}",
        "$description": "Faint accent tint.",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.50}",
              "Dark": "{primitive.color.mauve.900}"
            }
          }
        }
      },
      "content": {
        "$value": "{primitive.color.mauve.600}",
        "$description": "Accent text and links.",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.600}",
              "Dark": "{primitive.color.mauve.300}"
            }
          }
        }
      },
      "contentHover": {
        "$value": "{primitive.color.mauve.700}",
        "$description": "Accent text hover.",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.mauve.700}",
              "Dark": "{primitive.color.mauve.200}"
            }
          }
        }
      }
    },
    "color": {
      "$type": "color",
      "surface": {
        "accent": {
          "$value": "{primitive.color.mauve.600}",
          "$description": "Accent surface fill: CTAs, primary buttons.",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.mauve.600}",
                "Dark": "{primitive.color.mauve.300}"
              }
            }
          }
        },
        "accentSubtle": {
          "$value": "{primitive.color.mauve.50}",
          "$description": "Faint accent tint surface.",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.mauve.50}",
                "Dark": "{primitive.color.mauve.900}"
              }
            }
          }
        }
      },
      "border": {
        "accent": {
          "$value": "{primitive.color.mauve.600}",
          "$description": "Accent border and focus ring.",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.mauve.600}",
                "Dark": "{primitive.color.mauve.300}"
              }
            }
          }
        }
      },
      "content": {
        "accent": {
          "$value": "{primitive.color.mauve.600}",
          "$description": "Accent content colour.",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.mauve.600}",
                "Dark": "{primitive.color.mauve.300}"
              }
            }
          }
        }
      }
    }
  }
}
