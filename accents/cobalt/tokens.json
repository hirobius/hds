{
  "$schema": "../../hirobius.tenant-tokens.schema.json",
  "$description": "Cobalt accent theme: an opt-in swap of the accent tokens only, activated by data-accent=\"cobalt\" on the root (or any wrapper). Graphite stays the default. Same overlay format and rules as a tenant (no primitive overrides, paths must exist in hirobius.tokens.json); emitted to src/styles/accents.css by scripts/build-tokens.mjs. Roles: accent 600 (white text 8.19:1), hover and pressed 700, selected and subtle background 50; dark mode accent 300 (7.86:1 on black).",
  "role": {
    "primary": {
      "$type": "color",
      "$value": "{semantic.color.surface.accent}",
      "$description": "Cobalt accent: re-anchored to the overridden surface.accent. --role-primary is declared on :root, so without this line a [data-accent] set below <html> leaves Button (bg-primary) on the default accent in light mode."
    },
    "ring": {
      "$type": "color",
      "$value": "{semantic.color.border.accent}",
      "$description": "Cobalt accent: re-anchored to the overridden border.accent, for the focus ring (same reason as role.primary)."
    },
    "accent": {
      "$type": "color",
      "$value": "{semantic.color.surface.accentSubtle}",
      "$description": "Cobalt accent: re-anchored to the overridden accentSubtle (hover fills; same reason as role.primary)."
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{semantic.color.content.accent}",
      "$description": "Cobalt accent: re-anchored to the overridden content.accent (same reason as role.primary)."
    }
  },
  "component": {
    "$type": "color",
    "$description": "Cobalt accent: every component alias of an overridden accent token, re-declared with the same alias as base. They are declared on :root, so a [data-accent] below <html> would otherwise leave Button's primary hover, the secondary Button's hover, an active Tag and the active nav item on the default graphite in light mode.",
    "button": {
      "bg": {
        "$value": "{semantic.color.surface.accent}"
      },
      "bgHover": {
        "$value": "{semantic.accent.hover}"
      },
      "secondary": {
        "bg": {
          "hover": {
            "$value": "{semantic.color.surface.accentSubtle}"
          }
        },
        "border": {
          "hover": {
            "$value": "{semantic.color.border.accent}"
          },
          "pressed": {
            "$value": "{semantic.color.border.accent}"
          }
        }
      }
    },
    "tag": {
      "activeBackground": {
        "$value": "{semantic.accent.rest}"
      },
      "activeBorder": {
        "$value": "{semantic.accent.rest}"
      },
      "activeHover": {
        "$value": "{semantic.accent.hover}"
      }
    },
    "nav": {
      "bgActive": {
        "$value": "{semantic.accent.subtle}"
      },
      "borderActive": {
        "$value": "{semantic.color.surface.accent}"
      }
    }
  },
  "semantic": {
    "accent": {
      "$type": "color",
      "rest": {
        "$value": "{primitive.color.cobalt.600}",
        "$description": "Cobalt accent fill: cobalt.600 in light (white text 8.19:1), cobalt.300 in dark (black text 7.86:1).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.600}",
              "Dark": "{primitive.color.cobalt.300}"
            }
          }
        }
      },
      "hover": {
        "$value": "{primitive.color.cobalt.700}",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.700}",
              "Dark": "{primitive.color.cobalt.400}"
            }
          }
        }
      },
      "pressed": {
        "$value": "{primitive.color.cobalt.700}",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.700}",
              "Dark": "{primitive.color.cobalt.400}"
            }
          }
        }
      },
      "subtle": {
        "$value": "{primitive.color.cobalt.50}",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.50}",
              "Dark": "{primitive.color.cobalt.900}"
            }
          }
        }
      },
      "content": {
        "$value": "{primitive.color.cobalt.600}",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.600}",
              "Dark": "{primitive.color.cobalt.300}"
            }
          }
        }
      },
      "contentHover": {
        "$value": "{primitive.color.cobalt.700}",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "{primitive.color.cobalt.700}",
              "Dark": "{primitive.color.cobalt.200}"
            }
          }
        }
      }
    },
    "color": {
      "$type": "color",
      "surface": {
        "accent": {
          "$value": "{primitive.color.cobalt.600}",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.cobalt.600}",
                "Dark": "{primitive.color.cobalt.300}"
              }
            }
          }
        },
        "accentSubtle": {
          "$value": "{primitive.color.cobalt.50}",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.cobalt.50}",
                "Dark": "{primitive.color.cobalt.900}"
              }
            }
          }
        }
      },
      "border": {
        "accent": {
          "$value": "{primitive.color.cobalt.600}",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.cobalt.600}",
                "Dark": "{primitive.color.cobalt.300}"
              }
            }
          }
        }
      },
      "content": {
        "accent": {
          "$value": "{primitive.color.cobalt.600}",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.cobalt.600}",
                "Dark": "{primitive.color.cobalt.300}"
              }
            }
          }
        },
        "onAccent": {
          "$value": "{primitive.color.neutral.white}",
          "$description": "White on the cobalt.600 fill (8.19:1) in light, black on the cobalt.300 fill (7.86:1) in dark.",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "{primitive.color.neutral.white}",
                "Dark": "{primitive.color.neutral.black}"
              }
            }
          }
        }
      }
    }
  }
}
